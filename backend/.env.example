# Health AI Summarizer — Backend Environment Configuration
# Copy this file to .env and insert your real credentials
PORT=5000

# PostgreSQL Database Connection String (Target: Supabase, Neon, Railway, or Render)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If left empty, the server automatically falls back to local JSON storage for offline development
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google Gemini API Key (Required for live Gemini AI Chat & Report Summarization)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Cloudinary Cloud Object Storage (for persistent cloud PDF file storage)
# If left empty, the system uses the high-performance local object store
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
