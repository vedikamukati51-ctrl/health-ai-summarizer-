# Health AI Summarizer — Frontend Environment Configuration
# Copy this file to .env and adjust variables as needed

# URL of the running backend Express API server
VITE_API_BASE_URL=http://localhost:5000

# Multipart upload field name expected by the backend
VITE_UPLOAD_FIELD=files

# Toggle mock demo fallback (set false to use live backend API)
VITE_DEMO_MODE=false
