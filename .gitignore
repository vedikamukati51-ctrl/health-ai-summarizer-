# ==============================================================================
# Health AI Summarizer — Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
backend/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL FOR SECURITY - NEVER COMMIT)
.env
.env.local
.env.*.local
backend/.env
backend/*.env
*.env

# Production Build Artifacts
dist/
dist-ssr/
build/
out/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Dynamically Uploaded User Files (Keep seeds & .gitkeep, ignore dynamic uploads)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/Ananya_Blood_Report_September.pdf
!backend/uploads/Ananya_CBC_August.pdf
!backend/uploads/Ananya_Health_Check_July.jpg

# Temporary & Archive Files
*.zip
*.tar.gz
*.rar
*.7z

# OS Specific
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
